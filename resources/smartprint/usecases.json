    {"id": "indoor", "max_temp": 35, "uv": false},
    {"id": "outdoor", "max_temp": 50, "uv": true},
    {"id": "car", "max_temp": 80, "uv": true},
    {"id": "electronics", "max_temp": 60, "uv": false},
    {"id": "engine", "max_temp": 110, "uv": false}
  ],
  "use_cases": [
